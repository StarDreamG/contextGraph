#!/usr/bin/env bash
set -euo pipefail

INVOKED_PATH="${BASH_SOURCE[0]}"
INVOKED_DIR="$(cd "$(dirname "$INVOKED_PATH")" && pwd)"
SOURCE_PATH="$INVOKED_PATH"

while [[ -L "$SOURCE_PATH" ]]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  [[ "$SOURCE_PATH" != /* ]] && SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH"
done

SCRIPT_DIR="$(cd "$(dirname "$SOURCE_PATH")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CLI_MAIN="$PROJECT_ROOT/dist/cli/main.js"
NODE_BIN="$INVOKED_DIR/node"

if [[ ! -x "$NODE_BIN" ]]; then
  NODE_BIN="$(command -v node || true)"
fi

if [[ -z "$NODE_BIN" ]]; then
  echo "ContextGraph requires Node.js >=22 <25, but node was not found." >&2
  exit 1
fi

if [[ ! -f "$CLI_MAIN" ]]; then
  echo "ContextGraph build output is missing. Run: cd $PROJECT_ROOT && npm run build" >&2
  exit 1
fi

exec "$NODE_BIN" "$CLI_MAIN" "$@"
